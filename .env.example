# Copy to .env and fill in. .env is gitignored: never commit real values.
# On Fargate these come from Secrets Manager instead (PIPELINE_SECRET_NAME).

# Square
SQUARE_ACCESS_TOKEN=
# production or sandbox
SQUARE_ENVIRONMENT=production

# Warehouse: redshift in production, postgres for local development
WAREHOUSE_TYPE=redshift
PGHOST=
PGPORT=5439
PGDATABASE=dev
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# AWS
AWS_REGION=us-east-1
S3_RAW_BUCKET=
# IAM role Redshift assumes to COPY from the bucket
REDSHIFT_IAM_ROLE=

# dbt target: prod = Redshift, dev = local Postgres
DBT_TARGET=prod
